<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ServicesEditor/ServicesEditor.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <Content Include="../services.schema.json" Link="services.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../services.example.json" Link="services.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
