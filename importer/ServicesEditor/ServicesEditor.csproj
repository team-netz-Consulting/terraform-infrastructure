<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <EmbeddedResource Include="../services.schema.json" LogicalName="services.schema.json" />
    <Content Include="../services.example.json" Link="services.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
