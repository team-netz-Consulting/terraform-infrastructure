# Grundkonfiguration fuer manage-terraform.py
ROOT_DIR="/pfad/zu/terraform-infrastructure"
TEMPLATE_DIR="${ROOT_DIR}/template"
ENVIRONMENTS_DIR="${ROOT_DIR}/environments"
UPDATE_CHECK_ENABLED="true"
UPDATE_SOURCE_DIR=""
ENVIRONMENT_FOLDER_STRUCTURE="single"
MASTER_BRANCH="master"
DEVELOP_BRANCH="develop"
GIT_REMOTE_NAME="origin"
GIT_GROUP_URL="https://gitlab.example.com/beispielgruppe"
GIT_GROUP_URL_NETSCALER="https://gitlab.example.com/beispielgruppe/netscaler"
GIT_GROUP_URL_ALTEON="https://gitlab.example.com/beispielgruppe/alteon"
GIT_REMOTE_URL="https://github.com/example/terraform-infrastructure.git"
GIT_USERNAME=""
GIT_PASSWORD=""
GIT_ACCESS_TOKEN=""
GIT_CREATE_REMOTE_PROJECTS="true"
GITLAB_API_URL="https://gitlab.example.com/api/v4"
GIT_COMMIT_AUTHOR_NAME="Terraform Manager"
GIT_COMMIT_AUTHOR_EMAIL="terraform-manager@example.com"
GIT_TEST_PROJECT_PREFIX="terraform-manager-test"
ACTIVE_ENVIRONMENT=""
TERRAFORM_TARGET_BRANCH="develop"
ALTEON_USE_LINUXENV="true"
ALTEON_USERNAME="admin"
NETSCALER_USE_LINUXENV="true"
NETSCALER_USERNAME="nsroot"
